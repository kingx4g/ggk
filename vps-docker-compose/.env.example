# با اجرای setup.sh این فایل به .env کپی و مقادیر رندوم توش پر میشه.
# اگه دستی می‌سازی، مقادیر زیر رو خودت پر کن.

POSTGRES_PASSWORD=change_me_strong_password
NODE_API_KEY=generate-a-uuid-here

# اختیاری: فقط اگه یک دامنه‌ی واقعی داری و می‌خوای از Caddy برای گواهی معتبر Let's Encrypt استفاده کنی.
# اگه خالی بذاری، سرویس caddy غیرفعال می‌مونه و مستقیم از https://<IP>:8000 وارد پنل میشی.
PANEL_DOMAIN=
